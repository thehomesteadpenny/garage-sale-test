{
  "name": "garage-sale-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler d1 migrations apply DB --local && wrangler dev",
   "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test:race": "node scripts/race-test.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SELLER_PASSWORD": {
        "description": "Pick the password you'll use to log in to your seller page. At least 8 characters."
      }
    }
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
